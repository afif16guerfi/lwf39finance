# انسخ هذا الملف إلى .env واملأ القيم الحقيقية (لا ترفع .env نفسه إلى git)

PORT=4001
JWT_SECRET=غيّر-هذا-إلى-نص-عشوائي-طويل-وسرّي
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-كلمة-السر-هذه

# مهم جدًا: يجب أن يكون هذا نفس رابط MONGODB_URI المستخدَم في مشروع
# lwf-eloued-referee-platform بالضبط — فالمشروعان يتشاركان نفس قاعدة
# البيانات (نفس حسابات المستخدمين ونفس البيانات المالية المسجَّلة سابقًا).
MONGODB_URI=

# Cloudinary — تُستخدم هنا فقط لرفع شعار الرابطة في إعدادات النظام المالي.
# استخدم نفس الحساب المستخدَم في مشروع منصة الحكام إن أردت.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
